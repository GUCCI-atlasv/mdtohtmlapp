{
  "manifest_version": 3,
  "name": "Save Page as HTML",
  "version": "1.3.0",
  "description": "Save the page you are reading as a clean HTML file. Markdown export remains available as a secondary option.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save page as HTML",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "save-as-html": {
      "suggested_key": { "default": "Alt+Shift+M", "mac": "MacCtrl+Shift+M" },
      "description": "Save the current page as HTML"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
